# ===== 推送渠道 =====
# 飞书自建应用（长连接 + 交互卡片）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_USER_OPEN_ID=

# 通用 Webhook（serve --channel webhook / digest --channel webhook）
# 支持格式：generic / slack / discord / dingtalk / feishu
AI_RADAR_WEBHOOK_URL=
AI_RADAR_WEBHOOK_FORMAT=generic
# Webhook 单独走代理时填这里；留空则直连
AI_RADAR_WEBHOOK_PROXY=

# ===== 模型 =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ===== 网络 =====
# 覆盖 config/sources.yaml 里的代理；留空表示直连
# AI_RADAR_PROXY=http://127.0.0.1:7897
